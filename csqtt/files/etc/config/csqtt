# CSQTT — конфигурация OpenWrt (UCI, /etc/config/csqtt).
# Схема M4a: csqtt-openwrt/uci.rs (typed pool: main + routing + профили server).
# Правила контракта:
#   - интерфейс csqtt0 фиксирован (не UCI-поле);
#   - runtime-состояние — только /var/run/csqtt/status.json, никогда здесь;
#   - секреты (password, vk_js_token) через статусы/LuCI не выдаются;
#   - device_id (только для ядра ≤ 2.1.x) привязан к паролю на сервере — переносить как есть, не генерировать;
#     ядро 2.5.0+ его не использует, пароль передаёт через окружение (не виден в ps).
# Профили удобнее добавлять CLI: csqtt profile import 'csqtt://…' --commit
# (или секцией config server ниже вручную).

config csqtt 'main'
	option enabled '0'
	# Имя TUN-интерфейса. Единственный экземпляр — csqtt0 (default); второй
	# экземпляр csqtt1 удалён (docs/panel-upgrade/DECISIONS.md D14).
	option ifname 'csqtt0'
	option selection_mode 'priority'
	option active_profile ''
	option failover '1'
	option failback '0'
	option health_interval '5'
	option fail_threshold '3'
	option success_threshold '2'
	option cooldown '60'
	option reconnect_delay '5'
	option failback_stable_time '60'
	option health_mode 'both'
	option health_target ''
	option captcha_policy 'failover'
	option tun_address ''
	option tun_mtu '1280'
	option dns ''
	option log_level 'info'
	option log_file '/var/log/csqtt.log'
	option log_size_kb '512'
	# --- Настройки ядра 2.5.0+ (не заданы = значения по умолчанию ядра). Можно задать здесь (общие)
	# --- или в секции профиля (переопределяют общие). В панели LuCI пока не отображаются.
	# option obfs 'unified'            # audio | video | unified (по умолчанию unified; у 2.1.x — audio)
	# option turn_transport 'udp'      # udp | tcp
	# option srtp_mode 'auto'          # auto | wrap | dtls
	# option workers '30'              # 1..100; ядро округляет до групп по 10 (если не exact_workers)
	# option exact_workers '0'         # 1 = ровно столько воркеров, без округления
	# option runtime_threads '0'       # потоки рантайма ядра; 0 = авто
	# option custom_turn_ips ''        # свои TURN-адреса: "1.2.3.4,5.6.7.8"
	# Маршрутизация ВНУТРИ ядра (пользовательский сетевой стек — заметно нагружает слабые роутеры):
	# option domain_routing '0'        # включить маршрутизацию по доменам (SNI)
	# option domain_whitelist '0'      # 1 = через туннель ТОЛЬКО перечисленные домены, остальное напрямую
	# option exclude_ru_zones '0'      # домены зон РФ — напрямую (не в режиме whitelist)
	# option template_domains '0'      # встроенный список доменов (domains.txt) — напрямую (не в whitelist)
	# option direct_domains ''         # свои домены напрямую: "a.com,b.org" (включает domain_routing)
	# option domains_file ''           # файлы со списками доменов: "/etc/csqtt/a.txt /etc/csqtt/b.txt"
	# option ip_routing '0'            # маршрутизация по IP
	# option ip_whitelist '0'          # 1 = через туннель ТОЛЬКО перечисленные IP/подсети
	# option direct_ips ''             # свои IP/подсети напрямую: "10.0.0.0/8,1.1.1.1"

# Контракт M3X: auto = interface-only (БЕЗ маршрутов/правил/таблиц — служба CSQTT их
# не ставит); none — отладочный алиас. Других режимов нет.
config csqtt 'routing'
	option mode 'auto'

# Шаблон профиля (раскомментировать и заполнить; enabled='1' только после
# проверки csqtt doctor):
#
# config server 'profile1'
# 	option name 'Main'
# 	option enabled '0'
# 	option priority '10'
# 	option peer '198.51.100.10:46000'
# 	option password 'SECRET'
# 	option vk 'hash1,hash2'
# 	option device_id 'uuid-привязан-к-паролю'
# 	option workers '18'
# 	option obfs 'audio'
# 	option turn_transport 'udp'
# 	option fingerprint 'chrome'
